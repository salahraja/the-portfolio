---
interface Props {
	title: string;
	language: string;
	description: string;
}

const { title, language, description } = Astro.props;
---

<!doctype html>
<html lang={language ?? "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	html {
		font-family: system-ui, sans-serif;
		background: #13151a;
		background-size: 224px;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	/* Claymorphism: one outer drop shadow toward the bottom-right, tinted to
	   the card's own color, plus an inset highlight concentrated along the
	   TOP edge only (a glossy dome rim), not a diagonal wash across the
	   whole surface. */
	.clay {
		/* Neutral default for dark/overlay surfaces (photos, black scrims);
		   boxes with a real background color override this inline to match
		   their own hue, and the white cards opt back into the accent purple
		   explicitly rather than getting it as an unrelated fallback. */
		--clay-tint: 20, 20, 28;
		border: none !important;
		border-radius: 32px !important;
		box-shadow:
			8px 14px 28px rgba(var(--clay-tint), 0.45),
			inset 0 12px 16px -4px rgba(255, 255, 255, 0.85),
			inset 0 -10px 16px -4px rgba(0, 0, 0, 0.2);
	}

	.dark .clay {
		box-shadow:
			8px 14px 28px rgba(var(--clay-tint), 0.65),
			inset 0 12px 16px -4px rgba(255, 255, 255, 0.22),
			inset 0 -10px 16px -4px rgba(0, 0, 0, 0.45);
	}

	/* Colored cards (ones that set their own --clay-tint) get an added
	   crisp shadow hugging the bottom-right edge, on top of their tinted
	   ambient glow. Light gray in light mode (a pure white shadow is
	   invisible against the white page background); white in dark mode. */
	.clay[style*="--clay-tint"] {
		box-shadow:
			8px 14px 28px rgba(var(--clay-tint), 0.45),
			6px 6px 0 -2px rgba(148, 148, 158, 0.55),
			inset 0 12px 16px -4px rgba(255, 255, 255, 0.85),
			inset 0 -10px 16px -4px rgba(0, 0, 0, 0.2);
	}

	.dark .clay[style*="--clay-tint"] {
		box-shadow:
			8px 14px 28px rgba(var(--clay-tint), 0.65),
			6px 6px 0 -2px rgba(255, 255, 255, 0.75),
			inset 0 12px 16px -4px rgba(255, 255, 255, 0.22),
			inset 0 -10px 16px -4px rgba(0, 0, 0, 0.45);
	}
</style>
